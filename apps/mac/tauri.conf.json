{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupa",
  "version": "0.1.0",
  "identifier": "app.rupa.mac",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rupa",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#1B1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "shortDescription": "Free video editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/node"],
    "resources": {
      "server-bundle/": "server/",
      "icon-build/Assets.car": "Assets.car"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
